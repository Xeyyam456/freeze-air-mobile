{
  "expo": {
    "name": "Freeze Air",
    "slug": "freeze-air-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freezeair",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "az.freezeair.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f6feb",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "az.freezeair.mobile"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e1626",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4f8dff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İş şəkillərini əlavə etmək üçün qalereyaya icazə lazımdır.",
          "cameraPermission": "İşin şəklini və videosunu çəkmək üçün kameraya icazə lazımdır.",
          "microphonePermission": "Video çəkəndə səs yazmaq üçün mikrofona icazə lazımdır."
        }
      ],
      "./plugins/withLocalCmake",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mağazanın dəqiq koordinatını yazmaq üçün cari yerinə icazə lazımdır."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "10819339-2f21-43b0-9853-740e7eb28ba0"
      }
    },
    "owner": "xeyyam456",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/10819339-2f21-43b0-9853-740e7eb28ba0",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
